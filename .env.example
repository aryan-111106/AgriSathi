# ──────────────────────────────────────────────────────────────
# Telegram Bot (primary channel — default)
# ──────────────────────────────────────────────────────────────
# Get a token from @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL where Telegram will deliver updates.
# For local dev, use ngrok: ngrok http 8000 → https://xxxx.ngrok-free.app
TELEGRAM_WEBHOOK_URL=
# Shared secret used in X-Telegram-Bot-Api-Secret-Token header
TELEGRAM_WEBHOOK_SECRET=agrisaathi_telegram_secret_2026
# "telegram" (default) or "whatsapp"
OUTBOUND_CHANNEL=telegram

# ──────────────────────────────────────────────────────────────
# Meta WhatsApp Business Cloud API (kept as fallback option)
# ──────────────────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=agrisaathi_secure_verify_token_2026

# ──────────────────────────────────────────────────────────────
# Google Gemini API (multimodal: vision + voice + text)
# ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# ──────────────────────────────────────────────────────────────
# Database & Application
# ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./agrisaathi.db

APP_NAME=AgriSaathi
APP_ENV=development
DEFAULT_LANGUAGE=bn
DEFAULT_STATE=West Bengal
DEFAULT_DISTRICT=Hooghly
DEBUG=true
